# Requer Node.js 22+. Configuracao local do backend.
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=calcular_gastos
JWT_SECRET=substitua_por_uma_chave_aleatoria

# Credenciais do projeto Tuya Cloud (opcionais para calculo manual).
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
# Use o endpoint do data center do seu projeto Tuya.
TUYA_BASE_URL=https://openapi.tuyaus.com

# Configure os Device IDs na tela Luz, em Salvar Tuya.
